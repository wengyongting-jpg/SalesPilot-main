# SalesPilot backend — local configuration.
#
# Copy this file to `.env` and configure as needed:
#
#     Copy-Item .env.example .env
#
# Nothing in this file is required. With no key at all the backend runs its offline
# path end to end: rule-based understanding and template replies, every one of them
# marked `generation: "template"` so nothing is mistaken for model output, and
# `/health` reporting `degraded: true`.
#
# Check what the backend actually picked up, without revealing the key:
#
#     py -3 -m backend --probe
#
# Test the API with zero cost (offline mode):
#
#     py -3 -m backend --test-api
#
# `--probe` separates "cannot reach the endpoint" from "the endpoint said no", because
# the first is the network or the URL and the second is the credential or the account.


# ---- Which model provider to use -------------------------------------------
# offline   (default) no model at all. Rules and templates. Fully functional. ZERO COST.
# gateway   an OpenAI-compatible endpoint, e.g. the hackathon gateway (COSTS MONEY)
# openai    OpenAI directly (COSTS MONEY)
#
# Anything other than `offline` also needs a key below. A provider named with no key
# runs offline rather than failing every message, and says so.
#
# ⚠️  IMPORTANT: Setting this to 'gateway' or 'openai' will make API calls and
#     incur charges. Keep it as 'offline' for zero-cost operation.
SALESPILOT_LLM=offline


# ---- Credentials -----------------------------------------------------------
# The key. Leave blank to stay offline.
SALESPILOT_LLM_API_KEY=

# The model name the provider expects.
SALESPILOT_LLM_MODEL=gpt-4o-mini

# Base URL for any OpenAI-compatible endpoint. Include the version path if the
# provider expects one, e.g. https://example.com/v1
#
# Nothing is guessed here: the backend appends only `/chat/completions`. A missing
# `/v1` is the most common misconfiguration, and it arrives as a 404 that looks
# exactly like a wrong model name — which is why `--probe` names both as suspects.
# Blank means the OpenAI default, https://api.openai.com/v1
SALESPILOT_LLM_BASE_URL=

# The organiser's gateway, if you have it. When set this wins over the base URL
# above, so you can keep both on hand and switch by commenting one out.
HACKATHON_LLM_GATEWAY_URL=


# ---- Limits ----------------------------------------------------------------
# Seconds before a model call is abandoned. The pipeline then completes on the
# offline peers rather than failing the request.
SALESPILOT_LLM_TIMEOUT=30

# Hard cap on model-selected tool calls in one agent segment. A runaway loop costs O(k squared): at
# fifty calls a single message runs to roughly 256,000 input tokens. Checked before
# a request is sent, so exceeding it costs nothing.
SALESPILOT_LLM_MAX_TOOL_STEPS=3

# Hard request and token caps for each of the two model segments (observation and
# reply composition). Token limits remain enforceable when a gateway model has no
# known price, so cost control never relies on the price table alone.
SALESPILOT_LLM_REQUEST_LIMIT=5
SALESPILOT_LLM_TOTAL_TOKEN_LIMIT=12000
SALESPILOT_LLM_OUTPUT_TOKEN_LIMIT=2500
SALESPILOT_LLM_PER_REQUEST_INPUT_TOKEN_LIMIT=6000

# Approximate USD ceiling per model segment. The full customer turn has two segments,
# so its theoretical ceiling is twice this value. Unknown-price providers also remain
# bounded by the request and token limits above.
SALESPILOT_LLM_COST_LIMIT_USD=0.03

# ---- Representative availability -----------------------------------------
# CareSure is fictional. These must be agreed demo operating hours, not hours
# copied from an unrelated insurer. Until configured, customer copy says that
# verified hours are unavailable. Keys: Monday=0 through Sunday=6; all times
# are Singapore time. Uncomment only after the team approves the schedule.
# SALESPILOT_STAFF_HOURS_JSON={"0":[["09:00","18:00"]],"1":[["09:00","18:00"]]}
# SALESPILOT_STAFF_CLOSED_DATES=2026-12-25,2027-01-01


# ---- Telemetry -------------------------------------------------------------
# Record the prompts and raw model output, and return them on the admin surface.
# Default on: the point of this project is to show what the agent actually did, and
# a hidden prompt cannot be reviewed. It may contain the customer's own words, which
# is why the switch exists — turn it off for anything resembling production. Never
# exposed on the customer surface under any setting.
SALESPILOT_TELEMETRY_CONTENT=on

# Print a per-run block to the terminal: each step with its kind, duration and
# status, each model call with tokens and cost, and a warning when a step degraded.
SALESPILOT_CONSOLE_TRACE=on

# DEBUG | INFO | WARNING | ERROR
SALESPILOT_LOG_LEVEL=INFO


# ---- HTTP ------------------------------------------------------------------
SALESPILOT_HOST=127.0.0.1
SALESPILOT_PORT=8000

# Browser origins allowed to call the API. The two frontends are served as static
# files on a different port, so they are always cross-origin; without this a browser
# refuses every request before it reaches the backend.
#
# The default covers the usual static-server ports on loopback. Deliberately not `*`:
# nothing here is protected today — there is no authentication anywhere, a recorded
# demo limitation — but a wildcard sets a habit that becomes a real hole the moment
# that changes. Comma-separated, and it must match the origin exactly, scheme and
# port included.
SALESPILOT_CORS_ORIGINS=http://127.0.0.1:8123,http://localhost:8123,http://127.0.0.1:5500,http://localhost:5500
