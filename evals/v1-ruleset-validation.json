        {"id": "t2", "text": "I submitted and paid yesterday.", "expect": {"intent": "payment", "posture": "unknown", "risks": [], "action": "verify_with_staff", "staff_reason": "order_verification", "evidence": ["t2"], "official_lifecycle_change": false}},
        {"id": "t3", "text": "So am I definitely insured now?", "expect": {"intent": "payment", "posture": "unknown", "risks": [], "action": "verify_with_staff", "staff_reason": "order_verification", "evidence": ["t2", "t3"], "official_lifecycle_change": false}}
      ]
    },
    {
      "id": "order_lookup_without_integration", "focus": "cannot invent a database result",
