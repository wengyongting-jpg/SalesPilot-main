  "pairwise_checks": [
    {"lower": "price_questions_are_browsing:t3", "higher": "readiness_overridden_by_delay:t1", "measure": "current_purchase_behaviour"},
    {"lower": "discount_condition:t2", "higher": "return_after_deferral:t3", "measure": "current_purchase_readiness"},
    {"lower": "readiness_overridden_by_delay:t3", "higher": "readiness_overridden_by_delay:t1", "measure": "current_purchase_behaviour"},
    {"lower": "explicit_decline_after_interest:t3", "higher": "explicit_decline_after_interest:t2", "measure": "current_purchase_behaviour"},
    {"equal_posture": ["complaint_after_decline:t1", "complaint_after_decline:t2"], "different_staff_reason": true},
    {"equal_posture": ["explicit_human_request_confirmation:t1", "explicit_human_request_confirmation:t2"], "different_staff_reason": true}
  ]
}
