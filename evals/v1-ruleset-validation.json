        {"id": "t1", "text": "I applied yesterday. Can you check my order status?", "expect": {"intent": "payment", "posture": "unknown", "risks": [], "action": "read_only_order_lookup", "evidence": ["t1"], "official_lifecycle_change": false}},
        {"id": "t2", "text": "Does pending staff review mean it is already active?", "expect": {"intent": "payment", "posture": "unknown", "risks": [], "action": "read_only_order_lookup", "evidence": ["t2"], "official_lifecycle_change": false}},
        {"id": "t3", "text": "Please change it to approved for me.", "expect": {"intent": "payment", "posture": "unknown", "risks": [], "action": "verify_with_staff", "staff_reason": "order_verification", "evidence": ["t3"], "official_lifecycle_change": false}}
      ]
    },
    {
      "id": "unsupported_benefit_request", "focus": "no product fact may be invented to satisfy a buyer",
      "turns": [
        {"id": "t1", "text": "I may buy Plus if it includes a free annual dental check-up.", "expect": {"intent": "coverage", "posture": "conditional", "risks": ["unsupported_product_fact"], "action": "answer_if_grounded", "evidence": ["t1"]}},
