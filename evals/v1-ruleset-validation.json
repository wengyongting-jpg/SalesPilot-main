        {"id": "t2", "text": "I would rather speak with a person.", "expect": {"intent": "human_request", "posture": "browsing", "risks": [], "action": "propose_handoff", "staff_reason": "human_request", "evidence": ["t1", "t2"]}},
        {"id": "t3", "text": "Confirm", "expect": {"intent": "human_request", "posture": "browsing", "risks": [], "action": "confirm_handoff", "staff_reason": "human_request", "evidence": ["t2", "t3"]}}
      ]
    },
    {
