{
  "suite": "salespilot-v1-ruleset-validation",
  "version": "draft-1",
  "status": "proposed_human_gold_review_required",
  "ruleset": "docs/v1.0/conversation-ruleset-proposal.md",
  "purpose": "Synthetic multi-turn validation of purchase posture, contextual intent, safety boundaries, evidence, and staff handoff. This is an oracle dataset, not a current API regression suite or a prompt/few-shot source.",
  "scope": {
    "order_integration": "absent unless a case explicitly provides a read-only fixture",
    "product_facts": "Only approved KB content may be stated; cases do not establish CareSure facts.",
    "staff_queue_rank": "not asserted; its ordering policy has not been approved",
    "scores": "no fixed numeric gold until weights are calibrated independently",
    "customer_messages_only": "Each turn is a customer message. Normal system replies may occur between turns, but are not gold response copy."
  },
  "oracle_fields": {
    "intent": "Primary current-turn task intent from the proposed ruleset, including unknown.",
    "posture": "Current conversation purchase posture after this turn; not an order or customer lifecycle status.",
    "risks": "Independent boundaries requiring grounded or restricted handling.",
    "action": "Required behavior category, not exact reply wording.",
    "evidence": "Customer turn IDs supporting the non-default posture or safety judgment; a later ID can supersede an earlier one.",
    "staff_reason": "Why staff attention might be needed, not a queue rank."
  },
  "allowed_values": {
    "posture": ["unknown", "browsing", "evaluating", "conditional", "ready_now", "deferred", "declined"],
    "action": ["answer_if_grounded", "clarify", "propose_handoff", "confirm_handoff", "cancel_handoff", "no_sales_pursuit", "verify_with_staff", "read_only_order_lookup", "refer_to_qualified_professional"],
    "staff_reason": ["none", "sales_followup", "human_request", "complaint", "restricted_decision", "custom_quote", "order_verification", "knowledge_gap"],
    "risk": ["unsupported_product_fact", "personalized_eligibility_or_underwriting", "medical_advice", "individual_claim_decision", "custom_quote_or_negotiation", "sensitive_data", "complaint"]
  },
  "global_invariants": [
    "A customer statement cannot create, confirm, or close an order or mark a customer active.",
    "A model-produced Conversion signal cannot change official order/customer lifecycle.",
    "Restricted content is withheld immediately, even before handoff confirmation.",
    "A handoff proposal does not create a case; confirmation does, cancellation does not.",
    "Staff attention is independent of purchase posture; no second HIGH/MEDIUM/LOW score is asserted.",
    "No unsupported product benefit, premium, discount, form, waiting time, or service-hour claim is permitted.",
    "An ambiguous utterance is not forced into a positive purchase label without relevant context."
  ],
  "cases": [
    {
      "id": "price_questions_are_browsing", "focus": "repeated factual questions do not imply purchase",
      "turns": [
        {"id": "t1", "text": "What does the Plus plan cover?", "expect": {"intent": "coverage", "posture": "browsing", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "How much is it per month?", "expect": {"intent": "price", "posture": "browsing", "risks": [], "action": "answer_if_grounded", "evidence": ["t1", "t2"]}},
        {"id": "t3", "text": "And what is the waiting period?", "expect": {"intent": "waiting_period", "posture": "browsing", "risks": [], "action": "answer_if_grounded", "evidence": ["t3"]}}
      ]
    },
    {
      "id": "comparison_without_commitment", "focus": "evaluation is not readiness or automatic compliance escalation",
      "turns": [
        {"id": "t1", "text": "I am comparing Plus with another insurer.", "expect": {"intent": "comparison", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "Their monthly price seems lower.", "expect": {"intent": "price", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t1", "t2"]}},
        {"id": "t3", "text": "I still need to compare the coverage before deciding.", "expect": {"intent": "comparison", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t3"]}}
      ]
    },
    {
      "id": "discount_condition", "focus": "unmet discount condition and human negotiation",
      "turns": [
        {"id": "t1", "text": "The Family plan looks useful for us.", "expect": {"intent": "generic", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "I will sign today if you give us 25% off.", "expect": {"intent": "price", "posture": "conditional", "risks": ["custom_quote_or_negotiation"], "action": "propose_handoff", "staff_reason": "custom_quote", "evidence": ["t2"]}},
        {"id": "t3", "text": "No discount, no deal for now.", "expect": {"intent": "price", "posture": "deferred", "risks": [], "action": "no_sales_pursuit", "evidence": ["t2", "t3"]}}
      ]
    },
    {
      "id": "timing_condition_vs_deferral", "focus": "future date is not present readiness",
      "turns": [
        {"id": "t1", "text": "How would I apply for Essential?", "expect": {"intent": "application", "posture": "browsing", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "I might buy it after my next pay day if the budget works.", "expect": {"intent": "price", "posture": "conditional", "risks": [], "action": "answer_if_grounded", "evidence": ["t2"]}},
        {"id": "t3", "text": "Actually, please leave this until next quarter.", "expect": {"intent": "generic", "posture": "deferred", "risks": [], "action": "no_sales_pursuit", "evidence": ["t2", "t3"]}}
      ]
    },
    {
      "id": "readiness_overridden_by_delay", "focus": "latest explicit position overrides historical best intent",
      "turns": [
        {"id": "t1", "text": "I want the Plus plan and I am ready to apply today.", "expect": {"intent": "application", "posture": "ready_now", "risks": [], "action": "answer_if_grounded", "staff_reason": "sales_followup", "evidence": ["t1"]}},
        {"id": "t2", "text": "Hold on, I need to speak with my partner first.", "expect": {"intent": "generic", "posture": "conditional", "risks": [], "action": "answer_if_grounded", "evidence": ["t1", "t2"]}},
        {"id": "t3", "text": "We decided to revisit this in three months.", "expect": {"intent": "generic", "posture": "deferred", "risks": [], "action": "no_sales_pursuit", "evidence": ["t3"]}}
      ]
    },
    {
      "id": "explicit_decline_after_interest", "focus": "negation outranks earlier purchase words",
      "turns": [
        {"id": "t1", "text": "I am interested in buying Family cover.", "expect": {"intent": "generic", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "I compared the plans with my partner.", "expect": {"intent": "comparison", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t2"]}},
        {"id": "t3", "text": "No thanks, I am not buying any plan now.", "expect": {"intent": "generic", "posture": "declined", "risks": [], "action": "no_sales_pursuit", "evidence": ["t3"]}}
      ]
    },
    {
      "id": "return_after_deferral", "focus": "a new explicit commitment can replace deferral",
      "turns": [
        {"id": "t1", "text": "Maybe next year, not now.", "expect": {"intent": "generic", "posture": "deferred", "risks": [], "action": "no_sales_pursuit", "evidence": ["t1"]}},
        {"id": "t2", "text": "I have reviewed the Family information since then.", "expect": {"intent": "coverage", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t2"]}},
        {"id": "t3", "text": "I want to proceed with Family today. What is the next step?", "expect": {"intent": "application", "posture": "ready_now", "risks": [], "action": "answer_if_grounded", "staff_reason": "sales_followup", "evidence": ["t3"]}}
      ]
    },
    {
      "id": "short_reply_with_context", "focus": "resolve elliptical plan reference from prior turns",
      "turns": [
        {"id": "t1", "text": "Please compare Essential and Plus for me.", "expect": {"intent": "comparison", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "The second one sounds more suitable, but I have not decided.", "expect": {"intent": "comparison", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t1", "t2"]}},
        {"id": "t3", "text": "How much is that one?", "expect": {"intent": "price", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t1", "t2", "t3"]}}
      ]
    },
    {
      "id": "unanchored_yes", "focus": "do not infer a purchase from a context-free yes",
      "turns": [
        {"id": "t1", "text": "Hello.", "expect": {"intent": "generic", "posture": "unknown", "risks": [], "action": "clarify", "evidence": []}},
        {"id": "t2", "text": "Yes.", "expect": {"intent": "unknown", "posture": "unknown", "risks": [], "action": "clarify", "evidence": []}},
        {"id": "t3", "text": "The insurance question, I mean.", "expect": {"intent": "unknown", "posture": "unknown", "risks": [], "action": "clarify", "evidence": []}}
      ]
    },
    {
      "id": "claim_procedure_vs_claim_outcome", "focus": "general process is distinct from individual decision",
      "turns": [
        {"id": "t1", "text": "How does the general claims process work?", "expect": {"intent": "claims", "posture": "unknown", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "What documents would I normally need?", "expect": {"intent": "claims", "posture": "unknown", "risks": [], "action": "answer_if_grounded", "evidence": ["t1", "t2"]}},
        {"id": "t3", "text": "Will my own claim definitely be paid?", "expect": {"intent": "claims", "posture": "unknown", "risks": ["individual_claim_decision"], "action": "propose_handoff", "staff_reason": "restricted_decision", "evidence": ["t3"]}}
      ]
    },
    {
      "id": "medical_underwriting_boundary", "focus": "medical disclosure does not authorize underwriting judgment",
      "turns": [
        {"id": "t1", "text": "I am considering Plus.", "expect": {"intent": "generic", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "I have diabetes. Will my application be approved?", "expect": {"intent": "underwriting", "posture": "evaluating", "risks": ["personalized_eligibility_or_underwriting", "sensitive_data"], "action": "propose_handoff", "staff_reason": "restricted_decision", "evidence": ["t2"]}},
        {"id": "t3", "text": "Can you guarantee there will be no exclusions?", "expect": {"intent": "underwriting", "posture": "evaluating", "risks": ["personalized_eligibility_or_underwriting"], "action": "propose_handoff", "staff_reason": "restricted_decision", "evidence": ["t3"]}}
      ]
    },
    {
      "id": "medical_advice_not_sales", "focus": "do not infer sales intent from health questions",
      "turns": [
        {"id": "t1", "text": "I want information about hospital coverage.", "expect": {"intent": "coverage", "posture": "browsing", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "Should I stop taking my medication before applying?", "expect": {"intent": "unknown", "posture": "browsing", "risks": ["medical_advice", "sensitive_data"], "action": "refer_to_qualified_professional", "evidence": ["t2"]}},
        {"id": "t3", "text": "I am asking for health advice, not saying I will buy.", "expect": {"intent": "unknown", "posture": "browsing", "risks": ["medical_advice"], "action": "refer_to_qualified_professional", "evidence": ["t3"]}}
      ]
    },
    {
      "id": "corporate_quote_not_auto_offer", "focus": "custom corporate quote needs authorized staff",
      "turns": [
        {"id": "t1", "text": "We need medical cover for 80 employees.", "expect": {"intent": "corporate_need", "posture": "evaluating", "risks": [], "action": "answer_if_grounded", "evidence": ["t1"]}},
        {"id": "t2", "text": "Can you prepare a binding quote for our company?", "expect": {"intent": "corporate_need", "posture": "evaluating", "risks": ["custom_quote_or_negotiation"], "action": "propose_handoff", "staff_reason": "custom_quote", "evidence": ["t2"]}},
        {"id": "t3", "text": "We may proceed if the quote works for us.", "expect": {"intent": "corporate_need", "posture": "conditional", "risks": ["custom_quote_or_negotiation"], "action": "propose_handoff", "staff_reason": "custom_quote", "evidence": ["t2", "t3"]}}
      ]
    },
    {
      "id": "explicit_human_request_confirmation", "focus": "requesting a person does not change buying posture",
