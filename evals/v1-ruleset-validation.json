        {"id": "t3", "text": "Yes, please send my complaint to an employee.", "expect": {"intent": "human_request", "posture": "declined", "risks": ["complaint"], "action": "confirm_handoff", "staff_reason": "complaint", "evidence": ["t2", "t3"]}}
      ]
    },
    {
      "id": "reported_payment_no_order_change", "focus": "customer claim is not a verified sale",
