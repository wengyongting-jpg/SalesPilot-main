        {"id": "t2", "text": "Can you check whether that order is active?", "expect": {"intent": "payment", "posture": "unknown", "risks": [], "action": "verify_with_staff", "staff_reason": "order_verification", "evidence": ["t2"], "official_lifecycle_change": false}},
        {"id": "t3", "text": "If you cannot check it, please say so.", "expect": {"intent": "payment", "posture": "unknown", "risks": [], "action": "verify_with_staff", "staff_reason": "order_verification", "evidence": ["t2", "t3"]}}
      ]
    },
    {
      "id": "future_read_only_order_lookup", "focus": "fixture for a later authorized order integration",
